```xml
<?xml version="1.0" encoding="utf-8"?>
<project>

	<!-- ========================= Application Settings ========================= -->

	<app
		title="Friday Night Funkin': Psych Engine"
		file="PsychEngine"
		packageName="com.shadowmario.psychengine"
		package="com.shadowmario.psychengine"
		main="Main"
		version="0.2.8"
		company="ShadowMario"
	/>

	<set name="APP_ID" value="0x0100f6c013bbc000" />

	<haxedef name="LINC_LUA_RELATIVE_DYNAMIC_LIB"/>

	<app preloader="flixel.system.FlxPreloader" />

	<set name="SWF_VERSION" value="11.8" />

	<!-- ===================== Psych Engine Customization ====================== -->

	<define name="MODS_ALLOWED" if="desktop" />
	<define name="HSCRIPT_ALLOWED" if="desktop" />
	<define name="LUA_ALLOWED" if="desktop" />
	<define name="ACHIEVEMENTS_ALLOWED" />
	<define name="DISCORD_ALLOWED" />
	<define name="TRANSLATIONS_ALLOWED" />
	<define name="IRIS_DEBUG" />
	<define name="officialBuild" />

	<!-- Multithreaded loading -->
	<define name="MULTITHREADED_LOADING" />

	<!-- Loading screen -->
	<define name="SHOW_LOADING_SCREEN" />
	<define name="PSYCH_WATERMARKS"/>

	<section if="officialBuild">
		<define name="TITLE_SCREEN_EASTER_EGG"/>
		<define name="BASE_GAME_FILES" />

		<define
			name="VIDEOS_ALLOWED"
			if="windows || linux || android || mac"
			unless="32bits"
		/>
	</section>

	<!-- ============================= Window ================================== -->

	<window
		width="1280"
		height="720"
		fps="60"
		background="#000000"
		hardware="true"
		vsync="false"
		allow-high-dpi="true"
	/>

	<window
		if="html5"
		resizable="true"
	/>

	<window
		if="desktop"
		orientation="landscape"
		fullscreen="false"
		resizable="true"
		vsync="false"
	/>

	<window
		if="mobile"
		orientation="landscape"
		fullscreen="true"
		width="0"
		height="0"
		resizable="false"
	/>

	<window
		if="switch"
		orientation="landscape"
		fullscreen="true"
		width="0"
		height="0"
		resizable="true"
	/>

	<!-- ============================ Build Paths ============================== -->

	<set name="BUILD_DIR" value="export/debug" if="debug" />
	<set name="BUILD_DIR" value="export/release" unless="debug" />
	<set name="BUILD_DIR" value="export/32bit" if="32bits" />

	<classpath name="source" />

	<!-- ========================== Game Assets ================================ -->

	<define name="CRASH_HANDLER" if="desktop release" />

	<!--
		IMPORTANT:
		These assets are intentionally NOT excluding MP3/OGG.
		This allows both formats to be available to the engine.
	-->

	<!-- Fonts -->
	<assets path="assets/fonts" />

	<!-- Shared assets -->
	<assets path="assets/shared" />

	<!-- Embedded assets -->
	<assets path="assets/embed" embed="true" />

	<!-- Songs -->
	<assets path="assets/songs" />

	<!-- Week assets -->
	<assets path="assets/week_assets" rename="assets" />

	<!-- Videos -->
	<assets path="assets/videos" if="VIDEOS_ALLOWED" />

	<!-- Translations -->
	<section if="TRANSLATIONS_ALLOWED">
		<assets path="assets/translations" rename="assets" />
	</section>

	<!-- Base Game -->
	<section if="BASE_GAME_FILES">

		<assets path="assets/base_game" rename="assets" />

		<haxelib name="grig.audio" />
		<haxelib name="funkin.vis" />

	</section>

	<!-- ============================== Mods =================================== -->

	<section if="MODS_ALLOWED">

		<assets
			path="example_mods"
			rename="mods"
			embed="false"
			type="template"
		/>

		<assets
			path="list.txt"
			rename="modsList.txt"
		/>

	</section>

	<!-- Miscellaneous -->
	<assets
		path="art/readme.txt"
		rename="do NOT readme.txt"
	/>

	<!-- =========================== OpenAL Config ============================= -->

	<section if="desktop">

		<assets
			path="alsoft.txt"
			rename="plugins/alsoft.ini"
			type="text"
			if="windows"
		/>

		<assets
			path="alsoft.txt"
			rename="plugins/alsoft.conf"
			type="text"
			unless="windows"
		/>

	</section>

	<!-- ============================= Libraries =============================== -->

	<haxelib name="flixel" version="5.6.1" />
	<haxelib name="flixel-addons" version="3.2.2" />
	<haxelib name="tjson" version="1.4.0" />

	<!-- Psych Engine -->
	<haxelib
		name="linc_luajit"
		if="LUA_ALLOWED"
	/>

	<haxelib
		name="hscript-iris"
		if="HSCRIPT_ALLOWED"
		version="1.1.3"
	/>

	<haxelib
		name="hxvlc"
		if="VIDEOS_ALLOWED"
		version="2.0.1"
	/>

	<haxelib
		name="hxdiscord_rpc"
		version="1.2.4"
		if="DISCORD_ALLOWED"
	/>

	<haxelib name="flxanimate" />

	<!-- ============================ Definitions ============================== -->

	<haxedef
		name="DISCORD_DISABLE_IO_THREAD"
		if="hxdiscord_rpc"
	/>

	<haxedef
		name="NO_PRECOMPILED_HEADERS"
		if="linux"
	/>

	<haxelib
		name="hxcpp-debug-server"
		if="debug"
	/>

	<haxedef
		name="HXC_LIBVLC_LOGGING"
		if="VIDEOS_ALLOWED debug"
	/>

	<haxedef
		name="HXVLC_NO_SHARE_DIRECTORY"
		if="VIDEOS_ALLOWED"
	/>

	<define name="x86_BUILD" if="32bits" />

	<!-- ========================== Flixel Options ============================= -->

	<haxedef name="FLX_NO_FOCUS_LOST_SCREEN" />

	<haxedef
		name="HXC_DEBUG_TRACE"
		if="debug"
	/>

	<haxedef
		name="FLX_NO_DEBUG"
		unless="debug"
	/>

	<haxedef
		name="NAPE_RELEASE_BUILD"
		unless="debug"
	/>

	<!-- ========================== Crash Handler ============================== -->

	<haxedef
		name="HXCPP_CHECK_POINTER"
		if="CRASH_HANDLER"
	/>

	<haxedef
		name="HXCPP_STACK_LINE"
		if="CRASH_HANDLER"
	/>

	<haxedef
		name="HXCPP_STACK_TRACE"
		if="CRASH_HANDLER"
	/>

	<!-- =========================== Haxe Settings ============================= -->

	<haxedef name="no-deprecation-warnings" />

	<haxedef
		name="message.reporting"
		value="pretty"
	/>

	<haxeflag
		name="--macro"
		value="allowPackage('flash')"
	/>

	<haxeflag
		name="--macro"
		value="include('my.pack')"
	/>

	<haxedef
		name="hscriptPos"
		if="HSCRIPT_ALLOWED"
	/>

	<!-- ============================== Icons ================================== -->

	<assets
		path="art/icons/iconOG.png"
		rename="icon.png"
		if="linux || mac"
	/>

	<icon
		path="art/icons/icon16.png"
		size="16"
	/>

	<icon
		path="art/icons/icon32.png"
		size="32"
	/>

	<icon
		path="art/icons/icon64.png"
		size="64"
	/>

	<icon
		path="art/icons/iconOG.png"
	/>

</project>
```
